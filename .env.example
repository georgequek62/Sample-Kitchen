# Copy this file to .env.local for local development.
# Keep real credentials in .env.local or Vercel environment settings; never commit them.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/SHADOW_DATABASE?sslmode=require"

# Add real keys only to the ignored .env.local file or the deployment's environment settings.
OPENAI_API_KEY=""
ZAPIER_MCP_TOKEN=""
IMPORT_ADMIN_TOKEN=""
